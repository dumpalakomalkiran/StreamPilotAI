APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=sqlite:///./streampilot.db
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT_SECONDS=20
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback
TWITCH_SCOPES=user:read:chat user:write:chat
LOG_LEVEL=INFO
# Demo mode is disabled by default. Set true only for local UI/testing without Twitch auth.
DEMO_MODE=false
